# ============ Telegram (required) ============
BOT_TOKEN=123456789:AAAA-your-bot-token
ADMIN_IDS=123456789              # comma-separated Telegram user ids
WEBHOOK_URL=https://your-service.onrender.com   # no trailing slash. Leave empty for long polling (dev)
WEBHOOK_SECRET=change-me-to-a-long-random-string-32chars   # >= 16 chars, required with WEBHOOK_URL

# ============ GGSoma (required) ============
GG_BASE_URL=https://ggsoma.store/api/partner/v1
GG_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Supabase (required) ============
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ============ Cryptomus (optional) ============
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_PAYMENT_KEY=

# ============ Server ============
PORT=3000
LOG_LEVEL=info                   # debug | info | warn | error
